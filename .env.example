# Required: existing Windows parent directory whose descendants are indexed.
SAVE_YOUR_MEMORY_ROOT="D:\Documents\Knowledge"

# Optional: generated SQLite catalog and Markdown wiki location.
# Defaults to %LOCALAPPDATA%\save-your-memory on Windows.
SAVE_YOUR_MEMORY_HOME="D:\SaveYourMemoryData"

# Optional: skip content extraction above this size while retaining metadata.
SAVE_YOUR_MEMORY_MAX_FILE_BYTES=26214400
