# Required: existing Windows parent directory whose descendants are indexed.
SAVE_YOUR_MEMORY_ROOT="D:\Documents\Knowledge"

# Optional: generated SQLite catalog and Markdown wiki location.
# Defaults to %LOCALAPPDATA%\save-your-memory on Windows.
SAVE_YOUR_MEMORY_HOME="D:\SaveYourMemoryData"

# Optional: skip content extraction above this size while retaining metadata.
SAVE_YOUR_MEMORY_MAX_FILE_BYTES=26214400

# Optional: add directory names to exclude while scanning.
# Defaults already skip .git, .omx, venv, .venv, build, dist, downloads, site-packages, and similar caches.
SAVE_YOUR_MEMORY_EXCLUDED_DIRECTORIES="vendor, third_party"

# Optional: add directory-name glob patterns to exclude.
# The default *.git skips downloaded source trees such as library.git.
SAVE_YOUR_MEMORY_EXCLUDED_DIRECTORY_GLOBS="cache-*"

# Optional: add file extensions to exclude while scanning.
# Defaults already skip CSV files.
SAVE_YOUR_MEMORY_EXCLUDED_EXTENSIONS=".csv, .tsv"

# Optional: cap the chunk size used for external-content FTS5 indexing.
SAVE_YOUR_MEMORY_CHUNK_BYTES=32768
